# Copy this file to .env on the NAS. Do not put shared API keys here.
WEB_PORT=5111
PUBLIC_ORIGINS=https://canvas.example.com

# Comma-separated exact hosts or wildcard suffixes such as *.example.com.
ALLOWED_UPSTREAM_HOSTS=api.openai.com,generativelanguage.googleapis.com,api.openlux.ai,yunwu.ai,api.minimaxi.com,api.xwang.store
ALLOWED_DOWNLOAD_HOSTS=api.openai.com,generativelanguage.googleapis.com,api.openlux.ai,yunwu.ai,api.minimaxi.com,api.xwang.store,*.openai.com,*.oaistatic.com,oaidalleapiprodscus.blob.core.windows.net,oaidalleapiprodweu.blob.core.windows.net,oaidalleapiprodwus.blob.core.windows.net,storage.googleapis.com

# Optional full HTTPS upload endpoint, for example https://api.example.com/upload.
# Its hostname must also appear in ALLOWED_UPSTREAM_HOSTS.
UPLOAD_PROXY_TARGET=

REQUEST_TIMEOUT_MS=300000
JSON_BODY_LIMIT_BYTES=67108864
UPLOAD_BODY_LIMIT_BYTES=134217728
RESPONSE_BODY_LIMIT_BYTES=67108864
DOWNLOAD_RESPONSE_LIMIT_BYTES=33554432
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
EXPENSIVE_RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_MAX=30
MAX_CONCURRENCY=8
MAX_CONCURRENCY_PER_IP=3
MAX_UPLOAD_CONCURRENCY=2
