FROM node:22-alpine

WORKDIR /app

COPY server/api-server.mjs server/security.mjs ./server/

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=5112

USER node

EXPOSE 5112

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:5112/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "server/api-server.mjs"]
